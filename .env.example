# Copy to .env and fill in. Never commit .env.

# --- Database ---
DB_NAME=recollect
DB_USER=recollect
DB_PASSWORD=change-me
DB_PORT=5432
# Interface the DB port publishes on. Defaults to loopback so Postgres is not
# exposed on a public host; set to 0.0.0.0 only for deliberate remote admin.
DB_BIND=127.0.0.1
# Host-side URL for local (non-Docker) development:
DATABASE_URL=postgres://recollect:change-me@localhost:5432/recollect

# --- Server ---
PORT=8080
SERVER_PORT=8080
# Secret for signing access tokens (generate: openssl rand -hex 32)
AUTH_TOKEN_SECRET=change-me

# --- Library (Docker deployment) ---
# Host path to the photo folder, mounted read/write into the container at /library.
# Recollect indexes it in place and never copies it; writes are limited to
# explicit trash/move operations.
LIBRARY_PATH=/path/to/your/photos

# --- Tuning (defaults shown) ---
TRASH_RETENTION_DAYS=7
SCAN_INTERVAL_HOURS=24
WORKER_CONCURRENCY=2
TRANSCODE_THREADS=2
CLUSTER_MAX_GAP_HOURS=3
CLUSTER_MAX_JUMP_KM=50
CLUSTER_MIN_SIZE=3

# --- OIDC single sign-on (optional) ---
# Point at a self-hosted IdP (authentik) to add an SSO button to the login
# page. Empty = feature off. authentik issuers are per-application:
# https://auth.example.com/application/o/<slug>/
#OIDC_ISSUER_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_BUTTON_LABEL=Sign in with SSO
