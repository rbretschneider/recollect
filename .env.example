# Copy to .env and fill in. Never commit .env.

# --- Database ---
DB_NAME=recollect
DB_USER=recollect
DB_PASSWORD=change-me
DB_PORT=5432
DATABASE_URL=postgres://recollect:change-me@localhost:5432/recollect

# --- Server ---
PORT=8080
# Secret for signing access tokens (generate: openssl rand -hex 32)
AUTH_TOKEN_SECRET=change-me

# --- Library (deployment) ---
# Host path to the photo library, mounted read/write into the container.
LIBRARY_PATH=/path/to/your/photos
