# Recollect production settings. Save as /opt/recollect/.env and replace the
# three REPLACE values. Everything else is optional.

# Postgres password (any strong random string)
DB_PASSWORD=REPLACE-ME

# Session signing secret: openssl rand -hex 32
AUTH_TOKEN_SECRET=REPLACE-ME

# Absolute host path to the photo folder. Indexed in place, never copied.
LIBRARY_PATH=/REPLACE/path/to/photos

# --- Optional (defaults shown) ---
#SERVER_PORT=8080
#TZ=America/New_York
#TRASH_RETENTION_DAYS=7
#SCAN_INTERVAL_HOURS=24
# Parallel background jobs (indexing, transcoding). Raise to sprint, lower to be gentle.
#WORKER_CONCURRENCY=2
# CPU threads per video transcode (ffmpeg). WORKER_CONCURRENCY x this = worst-case cores used.
#TRANSCODE_THREADS=2
# Memory suggestions: how many photos a cluster needs to count as an event,
# and the time/distance gaps that split events.
#CLUSTER_MIN_SIZE=7
#CLUSTER_MAX_GAP_HOURS=3
#CLUSTER_MAX_JUMP_KM=50
