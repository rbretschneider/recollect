<app-topbar />

<main class="dashboard">
  <header class="hello">
    <h1>{{ greeting() }}</h1>
    <p>{{ todayLabel }}</p>
  </header>

  @if (photosPending()) {
    <app-page-loading label="Gathering your day…" />
  }

  @if (loadFailed()) {
    <app-load-error message="Couldn’t reach your library just now." (retry)="load()" />
  } @else if (allLoaded() && onThisDay().length === 0 && suggestions().length === 0 && recentMemories().length === 0 && recentlyAdded().length === 0) {
    <section class="empty">
      <h2>Nothing here yet</h2>
      <p>As your library grows, this page fills with photos from past years and fresh memories.</p>
      <a class="cta" routerLink="/photos">Browse photos</a>
    </section>
  }

  @if (onThisDay().length > 0) {
    <section class="on-this-day" aria-label="This week, years ago">
      <div class="section-head">
        <h2>This week, years ago</h2>
        <a routerLink="/lookback">All look-backs ›</a>
      </div>
      <div class="stacks">
        @for (moment of onThisDay(); track moment.key) {
          <div class="stack">
            <button type="button" class="stack-tap" (click)="openSlideshow(moment)">
              <span class="fan">
                @for (item of stackPreview(moment); track item.id; let cardIndex = $index) {
                  <span class="polaroid" [attr.data-card]="cardIndex">
                    <img [src]="thumbUrl(item.id, 720)" alt="" loading="lazy" />
                  </span>
                }
              </span>
              <span class="caption">
                <span class="moment-head">
                  @if (moment.kind === 'memory') {
                    <app-icon name="sparkles" [size]="14" aria-hidden="true" />
                  } @else if (moment.kind === 'person') {
                    <app-icon name="user" [size]="14" aria-hidden="true" />
                  } @else {
                    <app-icon name="map-pin" [size]="14" aria-hidden="true" />
                  }
                  <strong>{{ moment.title }}</strong>
                </span>
                <span class="years">{{ yearsAgo(moment.year) }}</span>
                <span class="sub">{{ momentMeta(moment) }} · tap to relive</span>
              </span>
            </button>
            <div class="stack-actions">
              @if (moment.kind === 'memory' && moment.memoryId) {
                <a class="ghost-link" [routerLink]="['/memories', moment.memoryId]">Open memory</a>
              } @else if (moment.kind === 'person' && moment.personId) {
                <a class="ghost-link" [routerLink]="['/people', moment.personId]">See person</a>
              } @else {
                <button
                  type="button"
                  class="create-album"
                  [disabled]="savingAlbumKey() === moment.key"
                  [attr.aria-label]="'Create an album from ' + moment.title"
                  (click)="saveAsAlbum(moment)"
                >
                  @if (savingAlbumKey() === moment.key) {
                    <span class="spinner" aria-hidden="true"></span>
                    Creating…
                  } @else {
                    <app-icon name="images" [size]="16" />
                    Create album
                  }
                </button>
              }
            </div>
          </div>
        }
      </div>
    </section>
  }

  @if (recentlyAdded().length > 0) {
    <section class="recently-added" aria-label="Recently added">
      <div class="section-head">
        <h2>Recently added</h2>
        <a routerLink="/photos">All photos ›</a>
      </div>
      <div class="recent-row">
        @for (item of recentlyAdded().slice(0, 4); track item.id; let i = $index) {
          <button type="button" class="recent-tile" aria-label="Open photo" (click)="openRecent(i)">
            <img [src]="thumbUrl(item.id, 720)" alt="" loading="lazy" />
            @if (item.mediaType === 'video') {
              <span class="video-badge" aria-hidden="true">▶</span>
            }
          </button>
        }
      </div>
    </section>
  }

  @if (recentMemories().length > 0) {
    <section class="recent" aria-label="Recent memories">
      <div class="section-head">
        <h2>Jump back in</h2>
        <a routerLink="/memories">All memories ›</a>
      </div>
      <div class="cards">
        @for (memory of recentMemories(); track memory.id) {
          <a class="card" [routerLink]="['/memories', memory.id]">
            @if (memory.coverAssetId; as cover) {
              <img [src]="thumbUrl(cover, 720)" alt="" loading="lazy" />
            }
            <div class="veil"></div>
            <div class="caption">
              <h3>{{ memory.title }}</h3>
              <p>{{ spanLabel(memory) }} · {{ memory.assetCount }} photos</p>
            </div>
          </a>
        }
      </div>
    </section>
  }
  @if (suggestions().length > 0) {
    <section class="suggestions" aria-label="Suggested memories">
      <div class="section-head">
        <h2>Suggested memories</h2>
        <a routerLink="/memories/inbox">Review all ›</a>
      </div>
      <div class="cards">
        @for (suggestion of suggestions(); track suggestion.id) {
          <a class="card" routerLink="/memories/inbox">
            @if (suggestion.previewAssetIds[0]; as cover) {
              <img [src]="thumbUrl(cover, 720)" alt="" loading="lazy" />
            }
            <div class="veil"></div>
            <div class="caption">
              <h3>{{ suggestion.seedTitle }}</h3>
              <p>{{ spanLabel(suggestion) }} · {{ suggestion.assetCount }} photos</p>
            </div>
          </a>
        }
      </div>
    </section>
  }

</main>

@if (viewerIndex() !== null) {
  <app-asset-viewer
    [assets]="viewerAssets()"
    [startIndex]="viewerIndex()!"
    (closed)="closeViewer()"
    (deleted)="onViewerDeleted($event)"
  />
}

@if (slideshowItems(); as items) {
  <app-slideshow-overlay
    [items]="items"
    [title]="slideshowTitle()"
    [collection]="slideshowCollection()"
    (closed)="closeSlideshow()"
  />
}
